      "name": "query - 1"
    },
    {
      "type": 1,
      "content": {
        "json": "Activity Timeline"
      },
      "name": "text - 5"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SecurityIncident\r\n| where TimeGenerated > ago(7d)\r\n| summarize IncidentCount = count() by bin(TimeGenerated, 1h)\r\n| order by TimeGenerated asc",
        "size": 0,
        "timeContext": {
          "durationMs": 604800000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart"
      },
      "name": "query - 2"
    },
    {
      "type": 1,
      "content": {
        "json": "Detections by Rule"
      },
      "name": "text - 6"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SecurityIncident\r\n| where TimeGenerated > ago(7d)\r\n| summarize IncidentCount = count() by Title\r\n| order by IncidentCount desc",
        "size": 0,
        "timeContext": {
          "durationMs": 604800000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
