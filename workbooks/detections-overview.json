      "content": {
        "version": "KqlItem/1.0",
        "query": "SecurityIncident\r\n| where TimeGenerated > ago(7d)\r\n| summarize TotalIncidents = count()",
        "size": 1,
        "timeContext": {
          "durationMs": 604800000
        },
        "queryType": 0,
